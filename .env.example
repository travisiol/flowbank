# Public origin used for metadata, the token list and the public pool feed.
NEXT_PUBLIC_SITE_URL=https://flowbank.xyz

# Reown AppKit (WalletConnect) project id — create one at https://dashboard.reown.com
# Leave empty and the header falls back to the injected browser wallet only.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Robinhood Chain RPC used by the server-side readers and the /api/rpc proxy.
# The browser never talks to this URL directly.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Deployment manifest served by /api/launch. Defaults to config/launch.json.
# Point it at another file (or set FLOWBANK_PHASE=prelaunch) to rehearse the
# pre-launch screens.
FLOWBANK_LAUNCH_MANIFEST=
FLOWBANK_PHASE=


# Directory holding published holder-reward proofs (<epoch>.json). Empty = no claims.
FLOWBANK_REWARDS_DIR=data/rewards
